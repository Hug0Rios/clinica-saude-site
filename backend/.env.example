APP_ENV=local
APP_URL=http://localhost:8000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=clinica_vitalis
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# -------------------------------------------------------
# Configuração de E-mail via Resend (https://resend.com)
# -------------------------------------------------------
# 1. Crie conta gratuita em resend.com
# 2. Vá em API Keys → Create API Key
# 3. Cole a chave abaixo em MAIL_API_KEY
# 4. MAIL_FROM precisa de um domínio verificado no Resend
#    (ou use onboarding@resend.dev para testes locais)
# -------------------------------------------------------
MAIL_PROVIDER=resend
MAIL_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAIL_FROM=Clínica Vitalis <noreply@seudominio.com>
MAIL_TO=contato@clinicavitalis.com.br

# Enviar e-mail de confirmação ao paciente (true/false)
MAIL_PATIENT_CONFIRM=true
